// Zinchi International — "Brainstorm with Zinchi" platform schema
//
// Local/dev uses SQLite for a zero-config setup. To move to PostgreSQL
// (Supabase/Neon) for production: change `provider` below to "postgresql",
// point DATABASE_URL at the Postgres connection string, then re-run
// `npx prisma migrate dev`. Role/status fields are plain strings (validated
// in TypeScript via src/lib/validators.ts) so the schema is portable between
// both providers without native enum differences.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT | PROSPECTOR | ADMIN
  phone        String?
  avatarUrl    String?
  createdById  String?
  createdBy    User?    @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]   @relation("CreatedUsers")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursesCreated     Course[]         @relation("CourseCreator")
  materialsCreated   Material[]       @relation("MaterialCreator")
  assignmentsCreated Assignment[]     @relation("AssignmentCreator")
  mockExamsCreated   MockExam[]       @relation("MockExamCreator")
  enrollments        Enrollment[]     @relation("StudentEnrollments")
  enrollmentsAssigned Enrollment[]    @relation("EnrollmentAssignedBy")
  assignmentTargets  AssignmentTarget[] @relation("StudentAssignmentTargets")
  examAssignments    ExamAssignment[] @relation("StudentExamAssignments")
  examAssignmentsMade ExamAssignment[] @relation("ExamAssignedBy")
  materialAssignments     MaterialAssignment[] @relation("StudentMaterialAssignments")
  materialAssignmentsMade MaterialAssignment[] @relation("MaterialAssignedBy")

  @@map("users")
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  category      String   @default("General")
  level         String   @default("Beginner") // Beginner | Intermediate | Advanced
  durationWeeks Int      @default(4)
  imageUrl      String?
  isPublished   Boolean  @default(true)
  createdById   String
  createdBy     User     @relation("CourseCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  materials   Material[]
  assignments Assignment[]
  mockExams   MockExam[]
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id               String   @id @default(cuid())
  studentId        String
  student          User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedById     String
  assignedBy       User     @relation("EnrollmentAssignedBy", fields: [assignedById], references: [id])
  progressPercent  Int      @default(0)
  assignedAt       DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Material {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("NOTE") // PDF | VIDEO | LINK | NOTE
  url         String?
  content     String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("MaterialCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  assignments MaterialAssignment[]

  @@map("materials")
}

model MaterialAssignment {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation("StudentMaterialAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("MaterialAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([materialId, studentId])
  @@map("material_assignments")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("AssignmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  targets AssignmentTarget[]

  @@map("assignments")
}

model AssignmentTarget {
  id             String    @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User      @relation("StudentAssignmentTargets", fields: [studentId], references: [id], onDelete: Cascade)
  dueAt          DateTime
  status         String    @default("PENDING") // PENDING | SUBMITTED | LATE | GRADED
  submissionText String?
  submissionUrl  String?
  submittedAt    DateTime?
  grade          Int?
  feedback       String?
  createdAt      DateTime  @default(now())

  @@unique([assignmentId, studentId])
  @@map("assignment_targets")
}

model MockExam {
  id              String   @id @default(cuid())
  title           String
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id])
  durationMinutes Int      @default(60)
  createdById     String
  createdBy       User     @relation("MockExamCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  sections   ExamSection[]
  assignments ExamAssignment[]

  @@map("mock_exams")
}

model ExamSection {
  id         String   @id @default(cuid())
  mockExamId String
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  title      String
  order      Int      @default(0)

  questions Question[]

  @@map("exam_sections")
}

model Question {
  id               String @id @default(cuid())
  sectionId        String
  section          ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prompt           String
  type             String @default("SINGLE_CHOICE") // SINGLE_CHOICE | MULTIPLE_CHOICE
  options          String // JSON string: [{id,text}]
  correctOptionIds String // JSON string: string[]
  marks            Int    @default(1)
  order            Int    @default(0)

  answers ExamAnswer[]

  @@map("questions")
}

model ExamAssignment {
  id           String   @id @default(cuid())
  mockExamId   String
  mockExam     MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation("StudentExamAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("ExamAssignedBy", fields: [assignedById], references: [id])
  dueAt        DateTime
  status       String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | GRADED
  createdAt    DateTime @default(now())

  attempt ExamAttempt?

  @@unique([mockExamId, studentId])
  @@map("exam_assignments")
}

model ExamAttempt {
  id               String    @id @default(cuid())
  examAssignmentId String    @unique
  examAssignment   ExamAssignment @relation(fields: [examAssignmentId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  score            Int?
  totalMarks       Int?
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED

  answers ExamAnswer[]

  @@map("exam_attempts")
}

model ExamAnswer {
  id                String      @id @default(cuid())
  attemptId         String
  attempt           ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String      // JSON string: string[]
  isCorrect         Boolean     @default(false)

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String   @default("CONTACT") // CONTACT | APPLY
  status    String   @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  createdAt DateTime @default(now())

  @@map("enquiries")
}

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  role        String
  quote       String
  avatarUrl   String?
  isPublished Boolean @default(true)
  order       Int     @default(0)

  @@map("testimonials")
}
